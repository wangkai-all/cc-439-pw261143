# HTTP port for the intake UI/API
PORT=4477

# Directory scanned for supplier files (XML / PDF)
WATCH_DIR=./inbox

# SQLite database and archived originals
DATA_DIR=./data
# DB_FILE=/absolute/path/intake.db

# A file is only read after its size and mtime have been identical for
# SETTLE_MS and on two consecutive passes. Raise it on slow network shares.
SETTLE_MS=1200

# Fallback poll interval. The watcher is event-driven; polling recovers from
# missed events and from the directory disappearing / reappearing.
POLL_MS=2000

# Files above this size (bytes) are quarantined without being read into memory.
# MAX_FILE_BYTES=52428800
